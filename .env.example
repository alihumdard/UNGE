# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override the recipient. Defaults to CONTACTO.email
# (direccion@unge.ar) when unset.
CONTACTO_TO=

# Optional: sender. Defaults to Resend's shared sender, which works without
# verifying a domain. Switch to an unge.ar address once the domain is
# verified in Resend.
CONTACTO_FROM=
