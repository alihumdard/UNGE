# SMTP transport. This account only sends mail; it is not the inbox UNGE
# reads. Gmail needs an App Password here, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: override the recipient. Defaults to CONTACTO.email
# (direccion@unge.ar) when unset.
CONTACTO_TO=
